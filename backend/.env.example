# Koobiyee faylkan una bixi ".env". Ha gelin sirta dhabta ah Git.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/tawakal_db

# Ugu yaraan 32 xaraf oo random ah. Samee:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# Cinwaannada frontend-ka ee la oggol yahay (CORS), kala saar comma
CLIENT_URL=http://localhost:5173

# Aagga waqtiga ee warbixinnada
REPORT_TIMEZONE=Africa/Mogadishu

# Kaliya loo isticmaalo "npm run create-admin" (ikhtiyaari; haddii kale waa lagu weydiinayaa)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
